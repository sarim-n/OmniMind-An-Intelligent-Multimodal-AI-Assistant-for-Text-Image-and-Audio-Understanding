# ==============================================================================
# Intelligent Multimodal AI Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Hardware Profile & Runtime
# ------------------------------------------------------------------------------
# Active hardware profile: cpu | gpu_low (<=8GB) | gpu_mid (12-16GB) | gpu_high
# - cpu:      Qwen2.5-1.5B-Instruct (int8/GGUF), whisper-base int8, SmolVLM, RT-DETR small
# - gpu_low:  Qwen2.5-1.5B (or 7B 4-bit), Qwen2-VL-2B 4-bit, whisper-small, RT-DETR
# - gpu_mid:  Qwen2.5-7B 4-bit, Qwen2-VL-2B/7B 4-bit, whisper-large-v3
# - gpu_high: Qwen2.5-14B 4-bit, Qwen2-VL-7B 4-bit, whisper-large-v3, RT-DETR large
PROFILE=cpu

# Toggle mock models (set to true to test API and UI without downloading weights)
MOCK_MODELS=true

# Environment name: development | staging | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Database connection string (defaults to local SQLite; PostgreSQL when in docker-compose)
DATABASE_URL=sqlite:///./storage/dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_ai

# PostgreSQL container variables (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multimodal_ai

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Local storage root directory for user uploads and generated artifacts
STORAGE_DIR=storage
# ChromaDB persistence directory for conversation vector memory
CHROMA_PERSIST_DIR=storage/chroma

# ------------------------------------------------------------------------------
# ML Model Checkpoint Overrides (Optional)
# If left blank, defaults are selected automatically based on PROFILE
# ------------------------------------------------------------------------------
# Large Language Model (Hugging Face ID, strictly Apache-2.0 / MIT / BSD)
LLM_MODEL_ID=

# Optional local GGUF model file path for CPU backend (e.g., Qwen2.5-1.5B-Instruct-Q4_K_M.gguf)
GGUF_MODEL_PATH=

# Vision Language Model (Hugging Face ID, strictly Apache-2.0 / MIT / BSD)
VLM_MODEL_ID=

# Automatic Speech Recognition Model (faster-whisper identifier)
ASR_MODEL_ID=

# Zero-shot / Object Detector Model (RT-DETR, strictly Apache-2.0)
DETECTOR_MODEL_ID=

# Text Embedding Model (Multilingual: e5-small on CPU, bge-m3 on GPU)
TEXT_EMBEDDING_MODEL_ID=

# Image Embedding Model (Vision vector model for multimodal search)
IMAGE_EMBEDDING_MODEL_ID=

# ------------------------------------------------------------------------------
# Context Window & Conversation Memory Budgets (Tokens)
# ------------------------------------------------------------------------------
CONTEXT_LENGTH_LIMIT=4096
MEMORY_TOKEN_BUDGET=2048
SUMMARY_THRESHOLD_TOKENS=1536
MEMORY_TOP_K=3

# ------------------------------------------------------------------------------
# Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens (generate a strong key in production)
JWT_SECRET_KEY=dev-secret-key-change-in-production-1234567890

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Upload Constraints
# ------------------------------------------------------------------------------
# Maximum upload payload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Allowed file extensions per media type (JSON array format)
ALLOWED_IMAGE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp", ".bmp"]
ALLOWED_AUDIO_EXTENSIONS=[".wav", ".mp3", ".m4a", ".ogg", ".flac"]
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf", ".txt", ".csv"]

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Allowed origins for frontend clients (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend Environment Variables
# ------------------------------------------------------------------------------
# Backend API base URL consumed by Vite frontend
VITE_API_URL=http://localhost:8000
