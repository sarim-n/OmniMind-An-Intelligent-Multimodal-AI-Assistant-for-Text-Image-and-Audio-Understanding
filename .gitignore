# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing, typing, and linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Storage: ignore all user files while preserving directory structure
storage/**
!storage/**/
!storage/**/.gitkeep
*.db
*.sqlite
*.sqlite3

# Vector Database and cache directories
chroma_db/
chroma/
.chroma/
.cache/

# OS and IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
